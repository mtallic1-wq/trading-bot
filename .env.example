# --- LLM API KEY ---
GROQ_API_KEY=your_groq_api_key_here

# --- EMAIL DELIVERY (Brevo) ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=reports@nqbiasbot.com
BREVO_FROM_NAME="NQ Bias Bot Alerts"

# --- WHATSAPP DELIVERY (Twilio) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886

# --- PAYMENT INTEGRATION (Lemon Squeezy Webhook Secret) ---
# REQUIRED: webhooks are rejected (503) if this is not set.
LEMON_SQUEEZY_WEBHOOK_SECRET=your_lemon_squeezy_webhook_secret_here

# --- ES GAMMA LEVELS (FlashAlpha) ---
FLASHALPHA_API_KEY=your_flashalpha_api_key_here

# --- ADMIN ---
# Secret guarding /api/admin/upgrade. Leave blank to disable the endpoint entirely (returns 404).
ADMIN_API_KEY=generate_a_long_random_string_here

# --- SERVER SETTINGS (Optional) ---
PORT=8080
